{
  "name": "garmin-mcp-app",
  "version": "0.8.0",
  "mcpName": "io.github.chenhunghan/garmin-mcp-app",
  "description": "Run Coach: your Garmin data in Claude, ChatGPT and any MCP client — daily briefing, training trends, workout planning and interactive charts. Unofficial, not affiliated with Garmin.",
  "keywords": [
    "chatgpt",
    "claude",
    "garmin",
    "garmin-connect",
    "mcp",
    "mcp-app",
    "mcp-server",
    "running",
    "training"
  ],
  "homepage": "https://github.com/chenhunghan/garmin-mcp-app#readme",
  "bugs": "https://github.com/chenhunghan/garmin-mcp-app/issues",
  "license": "MIT",
  "author": "Hung-Han (Henry) Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenhunghan/garmin-mcp-app.git"
  },
  "bin": {
    "garmin-mcp-app": "dist/index.js"
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "tsc --noEmit && tsc --noEmit -p tsconfig.app.json",
    "start": "node dist/index.js",
    "dev": "concurrently \"vite build --watch\" \"esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --watch\"",
    "dev:ui": "vite --config vite.config.dev.ts",
    "dev:ui:demo": "GARMIN_DEMO=1 vite --config vite.config.dev.ts",
    "lint": "oxlint",
    "fmt": "oxfmt --write src/ packages/",
    "fmt:check": "oxfmt src/ packages/",
    "pack": "npm run build && mcpb pack . garmin-mcp-app.mcpb",
    "pack:chatgpt": "npm run build && node scripts/pack-chatgpt-plugin.mjs && node scripts/validate-chatgpt-plugin.mjs",
    "pack:validate": "mcpb validate manifest.json",
    "test:lib": "npm test --workspace=packages/garmin-connect",
    "test:live": "npm run test:live --workspace=packages/garmin-connect",
    "test": "vitest run",
    "typecheck:lib": "tsc --noEmit --project packages/garmin-connect/tsconfig.json",
    "prepare": "prek install || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@j178/prek": "^0.3.3",
    "@modelcontextprotocol/client": "^2.3.0",
    "@modelcontextprotocol/core": "^2.3.0",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "^2.3.0",
    "@tailwindcss/vite": "^4.2.0",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-is": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "ajv": "^8.20.0",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.4",
    "esbuild": "^0.28.2",
    "msw": "^2.15.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.49.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^5.0.3",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=20"
  }
}
